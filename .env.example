GEMINI_API_KEY=your_api_key
# One model, or several separated by commas. The app tries them in order if one is busy/unavailable.
GEMINI_CHAT_MODEL=gemini-flash-latest,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
